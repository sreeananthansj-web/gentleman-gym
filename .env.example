# Copy to .env (local) and set the same two variables in your hosting provider.
# Find both in Supabase: Project Settings -> API.
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_publishable_key
# NEVER put the service_role / secret key here. Anything starting with VITE_ is
# bundled into public browser code. The app refuses to start with a service_role key.
